---
import '../styles/global.css';
import profile from '../data/profile.json';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = profile.bio } = Astro.props;
const fullTitle = title ? `${title} — ${profile.name}` : `${profile.name} — Personal Page`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="dark" />
  <meta name="description" content={description} />
  <link rel="icon" href="data:," />
  <title>{fullTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="/"><span class="brand-mark">{profile.name[0]}</span><span>{profile.name}</span></a>
      <nav class="nav-links" aria-label="Site sections">
        <a href="/#story">Story</a>
        <a href="/moments/">Moments</a>
        <a href="/#photos">Photos</a>
        <a href="/#projects">Projects</a>
        <a href="/#work">Work</a>
        <a href="/#rival">Rival</a>
        <a href="/#connect">Connect</a>
      </nav>
    </div>
  </header>

  <slot />

  <SiteFooter />
</body>
</html>

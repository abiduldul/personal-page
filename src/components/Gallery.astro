---
// Photo grid with optional filter buttons and a full-size lightbox.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryPhoto {
  src: ImageMetadata;
  alt: string;
  title: string;
  subtitle?: string;
  album?: string;
  href?: string;
}
interface Props {
  photos: GalleryPhoto[];
  filters?: { value: string; label: string }[];
  wideEvery?: boolean;
}
const { photos, filters = [], wideEvery = true } = Astro.props;
const items = await Promise.all(
  photos.map(async (p) => ({ ...p, full: (await getImage({ src: p.src, width: 1600 })).src })),
);
---
{filters.length > 0 && (
  <div class="filters" role="group" aria-label="Filter gallery">
    <button type="button" data-filter="all" aria-pressed="true">All photos</button>
    {filters.map((f) => <button type="button" data-filter={f.value} aria-pressed="false">{f.label}</button>)}
  </div>
)}
<div class:list={['gallery', { photos: !wideEvery }]} data-gallery>
  {items.map((p) => (
    <button type="button" class:list={['g-item', { wide: wideEvery && p.src.width > p.src.height }]}
      data-cat={p.album} data-full={p.full} data-caption={p.subtitle ? `${p.title} — ${p.subtitle}` : p.title} data-href={p.href}>
      <Image src={p.src} alt={p.alt} widths={[400, 800]} sizes="(max-width: 480px) 100vw, 400px" />
      <span class="gcap"><b>{p.title}</b>{p.subtitle && <span>{p.subtitle}</span>}</span>
    </button>
  ))}
</div>

<dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
  <figure>
    <img id="lbImg" alt="" />
    <figcaption id="lbCap"></figcaption>
  </figure>
  <a class="lb-close" id="lbLink" hidden style="text-decoration:none; text-align:center; width:max-content">Open this moment →</a>
  <button type="button" class="lb-close" id="lbClose">Close ✕</button>
</dialog>

<script>
  const items = document.querySelectorAll<HTMLElement>('.g-item');
  const fbtns = document.querySelectorAll<HTMLButtonElement>('.filters button');
  fbtns.forEach((b) =>
    b.addEventListener('click', () => {
      fbtns.forEach((x) => x.setAttribute('aria-pressed', 'false'));
      b.setAttribute('aria-pressed', 'true');
      const f = b.dataset.filter;
      items.forEach((it) => (it.hidden = !(f === 'all' || it.dataset.cat === f)));
    }),
  );
  const dlg = document.getElementById('lightbox') as HTMLDialogElement;
  const lbImg = document.getElementById('lbImg') as HTMLImageElement;
  const lbCap = document.getElementById('lbCap')!;
  const lbLink = document.getElementById('lbLink') as HTMLAnchorElement;
  items.forEach((it) =>
    it.addEventListener('click', () => {
      lbImg.src = it.dataset.full ?? '';
      lbImg.alt = it.querySelector('img')?.alt ?? '';
      lbCap.textContent = it.dataset.caption ?? '';
      lbLink.hidden = !it.dataset.href;
      if (it.dataset.href) lbLink.href = it.dataset.href;
      dlg.showModal();
    }),
  );
  document.getElementById('lbClose')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

---
// A single card inside a CardRow. With `href` it is a link; without, a plain card (used for projects).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href?: string;
  label: string;
  title: string;
  text?: string;
  image?: ImageMetadata;
  alt?: string;
  emoji?: string;
  tags?: string[];
}
const { href, label, title, text, image, alt = '', emoji, tags = [] } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="rcard" href={href}>
  {image
    ? <Image src={image} alt={alt} widths={[360, 720]} sizes="300px" />
    : <span class="rcard-art" aria-hidden="true">{emoji ?? title[0]}</span>}
  <span class="rcard-body">
    <span class="rcard-label">{label}</span>
    <span class="rcard-title">{title}</span>
    {text && <span class="rcard-text">{text}</span>}
    {tags.length > 0 && <span class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</span>}
  </span>
</Tag>
